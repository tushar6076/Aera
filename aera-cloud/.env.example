# ==============================================================================
# Aera Cloud Environment Configuration Template
# ==============================================================================

# --- Server & Environment ---
PROJECT_NAME="Aera Cloud"
ENVIRONMENT="development"
DEBUG=True
PORT=8085
HOST="0.0.0.0"

# --- Security & JWT Authentication ---
# Generate with: openssl rand -hex 32
SECRET_KEY="generate_a_random_32_byte_hex_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Hardware / ESP32 Device Ingestion ---
DEVICE_PRESHARED_KEY="your-device-preshared-key-for-esp32"

# --- Database Connections ---
# Local PostgreSQL (Default for local development)
DATABASE_URL="postgresql+asyncpg://<user>:<password>@localhost:5432/aera_db"
DIRECT_URL="postgresql://<user>:<password>@localhost:5432/aera_db"

# Production Neon PostgreSQL (Uncomment and replace credentials in production)
# DATABASE_URL="postgresql+asyncpg://neondb_owner:<PASSWORD>@<EP_NAME>.c-3.ap-southeast-1.aws.neon.tech/neondb?ssl=require"
# DIRECT_URL="postgresql://neondb_owner:<PASSWORD>@<EP_NAME>.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Redis Cache (Upstash) ---
REDIS_URL="rediss://default:<TOKEN>@<UPSTASH_ENDPOINT>:6379"

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN="your-cloudflare-tunnel-token"

# --- AI Integrations ---
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-120b"

# --- Titan Email (SMTP) ---
MAIL_SERVER="smtp.titan.email"
MAIL_PORT=465
MAIL_USERNAME="your-email@example.com"
MAIL_PASSWORD="your-titan-account-password"
MAIL_FROM="your-email@example.com"
MAIL_FROM_NAME="Aera by HackSmiths"
MAIL_USE_TLS=False
MAIL_USE_SSL=True

# --- Domains & Endpoints ---
CLOUD_BASE_URL="your-cloud-base-url"
WEB_BASE_URL="your-web-base-url"

# --- CORS Settings ---
BACKEND_CORS_ORIGINS='["your-frontend-url"]'