{
  "expo": {
    "name": "Aera",
    "slug": "aera-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/favicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icons/favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.hacksmiths.aera",
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleDarkContent"
      }
    },
    "android": {
      "package": "dev.hacksmiths.aera",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-icon-monochrome.png",
        "backgroundColor": "#f8fafc"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8fafc",
          "image": "./assets/icons/favicon.png",
          "imageWidth": 100
        }
      ]
    ]
  }
}